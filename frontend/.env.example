# CleverTap Web SDK Configuration
# -----------------------------------------------------------------------------
# When you receive your CleverTap Dashboard credentials:
# 1. Copy this file to `.env` in the frontend directory.
# 2. Replace the values below with your real CleverTap Account ID & Region.
# 3. Set VITE_CLEVERTAP_OFFLINE_MODE=false to send live data to your CleverTap dashboard.

# Your CleverTap Account ID (found in CleverTap Dashboard -> Settings)
VITE_CLEVERTAP_ACCOUNT_ID=CLEVERTAP_DEMO_ACCOUNT

# Your Account Region:
# in1  -> India (https://in1.dashboard.clevertap.com)
# us1  -> United States (https://us1.dashboard.clevertap.com)
# eu1  -> Europe / Default (https://eu1.dashboard.clevertap.com)
# sg1  -> Singapore (https://sg1.dashboard.clevertap.com)
# aps3 -> Indonesia (https://aps3.dashboard.clevertap.com)
# mec1 -> Middle East / UAE (https://mec1.dashboard.clevertap.com)
VITE_CLEVERTAP_REGION=in1

# Offline / Console Learning Mode:
# When 'true', the SDK queues all events locally and prints rich explanations in DevTools console.
# No network requests are sent to CleverTap, preventing failed request errors.
# Set to 'false' once you have valid credentials to stream data directly to your dashboard!
VITE_CLEVERTAP_OFFLINE_MODE=true
